{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NicoLauncher",
  "version": "0.3.9",
  "identifier": "io.github.snicolast.nicolauncher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NicoLauncher",
        "width": 1280,
        "height": 800,
        "center": true,
        "decorations": false,
        "minWidth": 940,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#0a0d16"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://raw.githubusercontent.com https://i.ytimg.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "snicolast",
    "shortDescription": "Installs, builds, updates and starts snicolast's projects",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNTZCRTA4NjkwQjQ2OTgKUldTWVJndHBDTDVXMHZzR0h6RkJVcXI0UGNwTEx4NndtU3piVjdDenkvS0Q3N3lKR3FhWVFjU2UK",
      "endpoints": [
        "https://github.com/snicolast/NicoLauncher-Hub/releases/latest/download/latest.json"
      ]
    }
  }
}
